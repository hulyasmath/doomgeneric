
ifeq ($(V),1)
	VB=''
else
	VB=@
endif


CC=emcc
CFLAGS+=-O2 -I../sdk -DFEATURE_SOUND -sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS='["mid"]'
LDFLAGS+=-O2 -sUSE_SDL=2 -sUSE_SDL_MIXER=2 -sSDL2_MIXER_FORMATS='["mid"]' --preload-file doom1.wad --preload-file timidity.cfg --preload-file freepats -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=67108864 -sEXPORTED_RUNTIME_METHODS='["ccall","cwrap","FS"]' -sEXPORTED_FUNCTIONS='["_main","_ZEQ_GetSnapshot","_ZEQ_GetExactSnapshot","_ZEQ_GetEvent","_ZEQ_SetPhaseBonus","_ZEQ_KeyEvent","_ZEQ_Mouse","_ZEQ_NewGame","_ZEQ_SaveGame","_ZEQ_LoadGame","_ZEQ_SetMuted","_ZEQ_SetRuleset","_ZEQ_GetImpulseRecord"]' -sNO_EXIT_RUNTIME=1 --shell-file ../web/shell.html
LIBS+=-lm

# subdirectory for objects
OBJDIR=build
OUTPUT=doomgeneric

SRC_DOOM = dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o i_video.o doomgeneric.o doomgeneric_emscripten.o zeq_doom.o zeq_time.o zeq_physics.o mus2mid.o i_sdlmusic.o i_sdlsound.o
OBJS += $(addprefix $(OBJDIR)/, $(SRC_DOOM))

all:	 $(OUTPUT)

clean:
	rm -rf $(OBJDIR)
	rm -f $(OUTPUT).html
	rm -f $(OUTPUT).js
	rm -f $(OUTPUT).data
	rm -f $(OUTPUT).wasm

$(OUTPUT):	$(OBJS) ../web/shell.html
	@echo [Linking $@]
	$(VB)$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) \
	-o $(OUTPUT).html $(LIBS)

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/zeq_time.o: ../sdk/zeq_time.c ../sdk/zeq_time.h ../sdk/zeq_sine_q30.inc | $(OBJDIR)
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/zeq_physics.o: ../sdk/zeq_physics.c ../sdk/zeq_physics.h ../sdk/zeq_time.h | $(OBJDIR)
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/%.o:	%.c
	@echo [Compiling $<]
	$(VB)$(CC) $(CFLAGS) -c $< -o $@

print:
	@echo OBJS: $(OBJS)
