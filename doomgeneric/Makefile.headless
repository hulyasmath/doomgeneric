CC ?= clang
CFLAGS ?= -O2 -g
CFLAGS += -std=c99 -Wall -Wextra -Wno-unused-parameter -DNORMALUNIX -DLINUX -DSNDSERV -D_DEFAULT_SOURCE -DZEQ_HEADLESS -I../sdk
LDFLAGS ?=
OBJDIR := build-headless
OUTPUT := doomgeneric-headless

SRC_DOOM := dummy.c am_map.c doomdef.c doomstat.c dstrings.c d_event.c d_items.c d_iwad.c d_loop.c d_main.c d_mode.c d_net.c f_finale.c f_wipe.c g_game.c hu_lib.c hu_stuff.c info.c i_cdmus.c i_endoom.o i_joystick.c i_scale.c i_sound.c i_system.c i_timer.c memio.c m_argv.c m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o w_checksum.o w_file.o w_main.c w_wad.c z_zone.c w_file_stdc.c i_input.c i_video.c doomgeneric.c doomgeneric_headless.c zeq_doom.c zeq_content.c zeq_capture.c zeq_headless.c zeq_sha256.c ../sdk/zeq_time.c ../sdk/zeq_physics.c
OBJECTS := $(addprefix $(OBJDIR)/,$(notdir $(SRC_DOOM:.c=.o)))

all: $(OUTPUT)

$(OUTPUT): $(OBJECTS)
	$(CC) $(LDFLAGS) $(OBJECTS) -o $@ -lm

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJECTS): | $(OBJDIR)

$(OBJDIR)/%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/zeq_time.o: ../sdk/zeq_time.c
	$(CC) $(CFLAGS) -c $< -o $@

$(OBJDIR)/zeq_physics.o: ../sdk/zeq_physics.c
	$(CC) $(CFLAGS) -c $< -o $@

../sdk/zeq_sine_q30.inc:
	python3 ../sdk/zeq_time.py --generate

clean:
	rm -rf $(OBJDIR) $(OUTPUT) $(OUTPUT).map

.PHONY: all clean
